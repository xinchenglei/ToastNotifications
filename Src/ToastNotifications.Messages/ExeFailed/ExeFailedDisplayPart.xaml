<core:NotificationDisplayPart
    x:Class="ToastNotifications.Messages.ExeFailed.ExeFailedDisplayPart"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="clr-namespace:ToastNotifications.Core;assembly=ToastNotifications"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ToastNotifications.Messages.ExeFailed"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignWidth="250"
    mc:Ignorable="d">
    <Border BorderThickness="1" CornerRadius="6">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#FF3333" />
                <GradientStop Offset="1" Color="#ff3399" />
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="3"
                Opacity="0.4"
                ShadowDepth="5" />
        </Border.Effect>
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Border
                    Margin="0,0,0,0"
                    Background="#FFFFFF10"
                    CornerRadius="4" />
                <StackPanel Orientation="Horizontal">
                    <Path
                        Width="10"
                        Height="10"
                        Margin="3,0,5,0"
                        Data="M 0,0 L 10,10 M 10,0 L 0,10"
                        Stroke="#FF3333"
                        StrokeThickness="2" />
                    <TextBlock
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="Red"
                        Text="执行失败" />
                </StackPanel>
            </Grid>

            <TextBlock
                x:Name="Text"
                Grid.Row="1"
                Margin="0,0,0,5"
                FontSize="12"
                Foreground="White"
                Text="{Binding Message, Mode=OneTime, FallbackValue=行为执行失败}"
                TextWrapping="Wrap" />

            <StackPanel
                Grid.Row="2"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <TextBlock
                    x:Name="TimestampText"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    FontSize="9"
                    Foreground="#FFFFFF"
                    Text="{Binding Timestamp, Mode=OneTime}" />
                <Button
                    x:Name="CloseButton"
                    Width="20"
                    Height="20"
                    Background="Transparent"
                    BorderBrush="#999999"
                    BorderThickness="1"
                    Click="OnClose"
                    Content="X"
                    Foreground="White" />
            </StackPanel>

            <Ellipse
                Width="8"
                Height="8"
                Margin="0,0,5,5"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Fill="#ff7070" />
        </Grid>
    </Border>

</core:NotificationDisplayPart>
