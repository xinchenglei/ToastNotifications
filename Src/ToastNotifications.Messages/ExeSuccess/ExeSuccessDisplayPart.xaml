<core:NotificationDisplayPart
    x:Class="ToastNotifications.Messages.ExeSuccess.ExeSuccessDisplayPart"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="clr-namespace:ToastNotifications.Core;assembly=ToastNotifications"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ToastNotifications.Messages.ExeSuccess"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignWidth="250"
    mc:Ignorable="d">
    <Border CornerRadius="6">
        <Border.Background>
            <DrawingBrush
                Opacity="0.3"
                TileMode="Tile"
                Viewport="0,0,0.1,0.1">
                <DrawingBrush.Drawing>
                    <GeometryDrawing Brush="#00ef67">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <LineGeometry StartPoint="0,0" EndPoint="100,100" />
                                <LineGeometry StartPoint="10,0" EndPoint="90,100" />
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                        <GeometryDrawing.Pen>
                            <Pen Brush="#00ef67" Thickness="0.5" />
                        </GeometryDrawing.Pen>
                    </GeometryDrawing>
                </DrawingBrush.Drawing>
            </DrawingBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="10"
                Opacity="0.7"
                ShadowDepth="5" />
        </Border.Effect>
        <Border CornerRadius="6">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Offset="0" Color="#00ef67" />
                    <GradientStop Offset="1" Color="#00efdf" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border
                    Grid.Row="0"
                    Margin="0,0,0,5"
                    Background="#6700ef"
                    BorderThickness="1"
                    CornerRadius="4">
                    <Border.Effect>
                        <DropShadowEffect
                            BlurRadius="4"
                            Opacity="0.5"
                            ShadowDepth="2" />
                    </Border.Effect>
                    <StackPanel Margin="5,2" Orientation="Horizontal">
                        <Ellipse
                            Width="13"
                            Height="13"
                            Margin="0,0,5,0">
                            <Ellipse.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Offset="0" Color="#00FF00" />
                                    <GradientStop Offset="1" Color="#00CC00" />
                                </LinearGradientBrush>
                            </Ellipse.Fill>
                            <Ellipse.Effect>
                                <DropShadowEffect
                                    BlurRadius="2"
                                    Opacity="0.4"
                                    ShadowDepth="1" />
                            </Ellipse.Effect>
                        </Ellipse>
                        <TextBlock
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="#00ef67 "
                            Text="执行成功" />
                    </StackPanel>
                </Border>

                <!--  正文  -->
                <TextBlock
                    x:Name="Text"
                    Grid.Row="1"
                    Margin="0,0,0,5"
                    FontSize="12"
                    Foreground="White"
                    Text="{Binding Message, Mode=OneTime, FallbackValue=行为执行成功}"
                    TextWrapping="Wrap" />

                <!--  时间戳和关闭按钮  -->
                <StackPanel
                    Grid.Row="2"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <TextBlock
                        x:Name="TimestampText"
                        Margin="0,0,8,0"
                        FontSize="9"
                        Foreground="#FFFFFF"
                        Text="{Binding Timestamp, Mode=OneTime}" />

                    <Button
                        x:Name="CloseButton"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Click="OnClose">
                        <Border
                            Width="20"
                            Height="20"
                            Background="Transparent"
                            BorderBrush="#777777"
                            BorderThickness="1"
                            CornerRadius="2">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="10"
                                Foreground="White"
                                Text="X" />
                            <Border.InputBindings>
                                <MouseBinding Command="{Binding CloseCommand}" Gesture="LeftClick" />
                            </Border.InputBindings>
                        </Border>
                    </Button>

                </StackPanel>

                <!--  装饰：铆钉  -->
                <Ellipse
                    Width="6"
                    Height="6"
                    Margin="-6"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Fill="#3dff90" />

                <Ellipse
                    Width="6"
                    Height="6"
                    Margin="-6"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Fill="#00a346" />
            </Grid>
        </Border>
    </Border>

</core:NotificationDisplayPart>
