<core:NotificationDisplayPart
    x:Class="ToastNotifications.Messages.Information.InformationDisplayPart"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="clr-namespace:ToastNotifications.Core;assembly=ToastNotifications"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignWidth="250"
    mc:Ignorable="d">

    <Border CornerRadius="6">
        <Border.Background>
            <DrawingBrush
                Opacity="0.3"
                TileMode="Tile"
                Viewport="0,0,0.1,0.1">
                <DrawingBrush.Drawing>
                    <GeometryDrawing Brush="#54E4F2">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <LineGeometry StartPoint="0,0" EndPoint="100,100" />
                                <LineGeometry StartPoint="10,0" EndPoint="90,100" />
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                        <GeometryDrawing.Pen>
                            <Pen Brush="#54E4F2" Thickness="0.5" />
                        </GeometryDrawing.Pen>
                    </GeometryDrawing>
                </DrawingBrush.Drawing>
            </DrawingBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="10"
                Opacity="0.7"
                ShadowDepth="5" />
        </Border.Effect>
        <Border Margin="2" CornerRadius="5">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Offset="0" Color="#54E4F2" />
                    <GradientStop Offset="1" Color="#5495f2" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border
                    Grid.Row="0"
                    Margin="0,0,0,5"
                    Background=" #F04C3C"
                    BorderThickness="1"
                    CornerRadius="4">
                    <Border.Effect>
                        <DropShadowEffect
                            BlurRadius="4"
                            Opacity="0.5"
                            ShadowDepth="2" />
                    </Border.Effect>
                    <StackPanel Margin="5,2" Orientation="Horizontal">
                        <Path
                            Width="14"
                            Height="14"
                            Margin="0,0,5,0"
                            Data="M 6,0 L 6,8 M 6,10 L 6,12"
                            Stroke="#54E4F2 "
                            StrokeThickness="2">
                            <Path.Effect>
                                <DropShadowEffect
                                    BlurRadius="2"
                                    Opacity="0.4"
                                    ShadowDepth="1" />
                            </Path.Effect>
                        </Path>
                        <TextBlock
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="#54E4F2"
                            Text="提示信息" />
                    </StackPanel>
                </Border>

                <TextBlock
                    x:Name="Text"
                    Grid.Row="1"
                    Margin="0,0,0,5"
                    FontSize="12"
                    Foreground="White"
                    Text="{Binding Message, Mode=OneTime, FallbackValue=某些需要被知道的信息}"
                    TextWrapping="Wrap" />

                <StackPanel
                    Grid.Row="2"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <TextBlock
                        x:Name="TimestampText"
                        Margin="0,0,8,0"
                        FontSize="9"
                        Foreground="#FFFFFF"
                        Text="{Binding Timestamp, Mode=OneTime}" />
                    <Button
                        x:Name="CloseButton"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Click="OnClose">
                        <Border
                            Width="20"
                            Height="20"
                            Background="Transparent"
                            BorderBrush="#777777"
                            BorderThickness="1"
                            CornerRadius="2">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="10"
                                Foreground="White"
                                Text="X" />
                            <Border.InputBindings>
                                <MouseBinding Command="{Binding CloseCommand}" Gesture="LeftClick" />
                            </Border.InputBindings>
                        </Border>
                    </Button>
                </StackPanel>

                <Ellipse
                    Width="6"
                    Height="6"
                    Margin="5,-5,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Fill="#6ce8f4" />
                <Ellipse
                    Width="6"
                    Height="6"
                    Margin="0,0,5,5"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Fill="#b3f3f9" />
            </Grid>
        </Border>
    </Border>

</core:NotificationDisplayPart>

